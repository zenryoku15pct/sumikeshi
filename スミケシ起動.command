#!/bin/bash
# スミケシ起動（macOS・ソースから使う場合）— ダブルクリックで実行
#
# 配布版（スミケシ.app）を使う場合はこのファイルは不要。アプリを直接ダブルクリックする。
cd "$(dirname "$0")"

if [ ! -x ./.venv/bin/python ]; then
  echo "まだセットアップが済んでいません。"
  echo "先に「セットアップ.command」をダブルクリックしてください。"
  exit 1
fi

# ターミナルと切り離して起動する。このウィンドウを閉じてもスミケシは動き続ける。
nohup ./.venv/bin/python gui.py >/dev/null 2>&1 &
echo "スミケシを起動しました。このウィンドウは閉じてかまいません。"
